# Runtime roots. Relative values are resolved from the current working directory.
MEDIA_SYNC_STATE_DIR=.media-sync
MEDIA_SYNC_ARCHIVE_DIR=archive
MEDIA_SYNC_EXPORT_DIR=exports
MEDIA_SYNC_JOB_DIR=jobs

# Optional root for confined file:<relative-path> secret references.
# MEDIA_SYNC_SECRET_FILE_DIR=C:/private/media-sync-secrets

# Optional external MediaCrawler bridge runtime. The Python interpreter must
# have the pinned upstream dependencies; license acknowledgement is never read
# from the environment and remains an explicit per-command decision.
MEDIA_SYNC_MEDIACRAWLER_LOCK_PATH=upstreams.lock.json
# MEDIA_SYNC_MEDIACRAWLER_PYTHON_EXECUTABLE=C:/private/MediaCrawler/.venv/Scripts/python.exe
# MEDIA_SYNC_MEDIACRAWLER_RUNTIME_DIR=C:/private/media-sync-runtime

# Optional explicit SQLAlchemy URL. Leave empty to use STATE_DIR/media-sync.sqlite3.
# MEDIA_SYNC_DATABASE_URL=sqlite+pysqlite:///C:/path/to/media-sync.sqlite3

# Local API defaults. Non-loopback binding will require authentication in a later milestone.
MEDIA_SYNC_API_HOST=127.0.0.1
MEDIA_SYNC_API_PORT=8632
MEDIA_SYNC_LOG_LEVEL=INFO

# Conservative collection defaults.
MEDIA_SYNC_DEFAULT_SYNC_INTERVAL_SECONDS=21600
MEDIA_SYNC_DEFAULT_MAX_ITEMS=30
MEDIA_SYNC_MAX_CRAWL_SECONDS=1800
